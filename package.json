{
  "name": "course-standards-mcp",
  "version": "0.1.0",
  "description": "MCP server that checks course material against Bloom-level learning objectives and a DE/EN term base.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Andreas Schliep",
  "bin": {
    "course-standards-mcp": "dist/server.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist",
    "data",
    "examples"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test \"test/**/*.test.ts\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "start": "node dist/server.js",
    "inspect": "npx @modelcontextprotocol/inspector node dist/server.js"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "js-yaml": "^4.3.2",
    "learning-objective-lint": "file:vendor/learning-objective-lint",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "eslint": "^10.14.0",
    "prettier": "^3.10.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2"
  }
}
